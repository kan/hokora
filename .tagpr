# tagpr: keeps a release pull request open against master and tags the release
# when it is merged. The workflow is .github/workflows/tagpr.yml; the release
# steps are in AGENTS.md ("リリース手順").
[tagpr]
	releaseBranch = master
	vPrefix = true
	# hokora keeps its version only in Git tags. The next version comes from
	# the release PR's labels: tagpr:minor / tagpr:major, otherwise a patch
	# release.
	#
	# tagpr makes only the vX.Y.Z tag. The sdk/vX.Y.Z tag on the same commit
	# is made by the sdk-tag job in tagpr.yml. tagpr does not count sdk/v* tags
	# as versions (it only reads tags that start with the version).
	versionFile = -
	# CHANGELOG.md is written by hand under "## [Unreleased]";
	# scripts/tagpr/release-prepare.mjs turns that section into the release's.
	# scripts/tagpr/ is a git subtree of kan/tagpr-scripts.
	changelog = false
	postVersionCommand = node scripts/tagpr/release-prepare.mjs --changelog-only
	# release.yml creates the GitHub release once the archives are built, with
	# the CHANGELOG section as its notes.
	release = false
	# A merged pull request labelled enhancement makes the release a minor one.
	minorLabels = enhancement
